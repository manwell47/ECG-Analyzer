{
    "name": "ecg-dwt-analyzer",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "ECG Signal Processing & AI Analysis Laboratory — browser-first, local-first, privacy-preserving. Phases 1-18 complete: browser UI, DWT analysis, worker-hosted DSP and ONNX Runtime inference.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/manwell47/ECG-Analyzer.git"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
        "lint": "eslint src vite.config.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "bench": "vitest bench",
        "build": "vite build",
        "check": "npm run typecheck && npm run svelte-check && npm run lint && npm run test && npm run build",
        "fixtures:write": "set FIXTURES_OVERWRITE=1&& vitest run src/fixtures"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@sveltejs/vite-plugin-svelte": "^5.1.1",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^22.10.0",
        "eslint": "^9.17.0",
        "jsdom": "^30.0.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.1",
        "vite": "^6.0.5",
        "vitest": "^3.0.0"
    },
    "dependencies": {
        "onnxruntime-web": "^1.29.0"
    }
}